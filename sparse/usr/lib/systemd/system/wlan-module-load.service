[Unit]
Description=Enable MT6768 Wi-Fi adapter
Conflicts=shutdown.target actdead.target
After=droid-hal-init.service
Requires=droid-hal-init.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/bin/sh /usr/bin/droid/enable-wifi.sh
ExecStop=/bin/sh /usr/bin/droid/disable-wifi.sh

[Install]
WantedBy=multi-user.target
