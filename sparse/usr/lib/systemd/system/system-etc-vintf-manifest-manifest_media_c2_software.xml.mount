[Unit]
Description=Mount for /system/etc/vintf/manifest/manifest_media_c2_software.xml
# The system VINTF manifest declares android.hardware.media.c2
# IComponentStore/software, normally served by mediaswcodec from the
# com.android.media.swcodec APEX, which does not run on Sailfish OS.
# Codec2Client then waits forever for it: gst-droid's plugin scan hangs,
# ngfd never registers, voicecall-manager blocks on it and the Phone app
# shows a spinner with no call providers. Hide the declaration.
Before=local-fs.target droid-hal-init.service
After=system.mount
Requires=system.mount

[Mount]
What=/usr/share/droid-config-merlinx/manifest_media_c2_software.xml
Where=/system/etc/vintf/manifest/manifest_media_c2_software.xml
Type=none
Options=bind
TimeoutSec=10

[Install]
WantedBy=local-fs.target
