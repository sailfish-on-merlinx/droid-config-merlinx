# usb-moded owns the USB gadget on Sailfish OS. The vendor AIDL USB gadget
# HAL aborts every few seconds here and can reconfigure the gadget
# (0e8d:d001), taking USB networking away from usb-moded.
service vendor.usb-gadget-hal /vendor/bin/hw/android.hardware.usb.gadget-service.mediatek_HYBRIS_DISABLED
    user root

# Android's usbd only drives the gadget through the AIDL IUsbGadget HAL
# disabled above; it then asks servicemanager to start it every second.
# No Android USB service should compete with usb-moded (mal, IRC 2026-05-09).
service usbd /system/bin/usbd_HYBRIS_DISABLED
    user root

# These cannot link on hybris and restart every 5 seconds, so they provide
# nothing and only flood the logs:
# - mediaserver64 needs libstatspull.so, which only exists in the statsd
#   APEX; Sailfish OS uses droidmedia's minimedia services instead.
# - vtservice (MediaTek ViLTE video calls) needs libnativehelper.so (ART).
# - the MediaTek NNAPI HAL needs libneuralnetworks.so; nothing uses NNAPI.
service media /system/bin/mediaserver64_HYBRIS_DISABLED
    user media
service vtservice /system_ext/bin/vtservice_HYBRIS_DISABLED
    user root
service neuralnetworks_hal_service_mtk_neuron /vendor/bin/hw/android.hardware.neuralnetworks@1.3-service-mtk-neuron_HYBRIS_DISABLED
    user root
