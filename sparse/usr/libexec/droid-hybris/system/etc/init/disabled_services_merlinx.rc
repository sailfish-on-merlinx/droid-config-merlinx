# usb-moded owns the USB gadget on Sailfish OS. The vendor AIDL USB gadget
# HAL aborts every few seconds here and can reconfigure the gadget
# (0e8d:d001), taking USB networking away from usb-moded.
service vendor.usb-gadget-hal /vendor/bin/hw/android.hardware.usb.gadget-service.mediatek_HYBRIS_DISABLED
    user root

# Android's usbd only drives the gadget through the AIDL IUsbGadget HAL
# disabled above; it then asks servicemanager to start it every second.
# No Android USB service should compete with usb-moded (mal, IRC 2026-05-09).
service usbd /system/bin/usbd_HYBRIS_DISABLED
    user root

# Nothing on Sailfish OS uses these:
# - vtservice is MediaTek's ViLTE (video call) service.
# - the MediaTek NNAPI HAL; nothing uses NNAPI.
# (mediaserver is not listed: on Android >= 12 it provides media.player and
# media.resource_manager for droidmedia, which no longer fakes them.)
service vtservice /system_ext/bin/vtservice_HYBRIS_DISABLED
    user root
service neuralnetworks_hal_service_mtk_neuron /vendor/bin/hw/android.hardware.neuralnetworks@1.3-service-mtk-neuron_HYBRIS_DISABLED
    user root

# APEX services that init.rc starts by name once init parses the init scripts
# of every APEX (post-fs-data perform_apex_config). Sailfish OS needs only
# media.swcodec (software Codec2: AAC for video recording); keep ART, the
# Android flag daemon, statsd and the BPF loader (its failure reboots the
# device) from running. Defined here first, so the APEX definitions of the
# same names are ignored, as upstream does for bpfloader.
service art_boot /apex/com.android.art/bin/art_boot_HYBRIS_DISABLED
    oneshot
service derive_classpath /apex/com.android.sdkext/bin/derive_classpath_HYBRIS_DISABLED
    oneshot
service derive_sdk /apex/com.android.sdkext/bin/derive_sdk_HYBRIS_DISABLED
    oneshot
service mainline_aconfigd_bootstrap_init /apex/com.android.configinfrastructure/bin/aconfigd-mainline_HYBRIS_DISABLED
    oneshot
service mainline_aconfigd_init /apex/com.android.configinfrastructure/bin/aconfigd-mainline_HYBRIS_DISABLED
    oneshot
service mainline_aconfigd_socket_service /apex/com.android.configinfrastructure/bin/aconfigd-mainline_HYBRIS_DISABLED
    oneshot
service statsd /apex/com.android.os.statsd/bin/statsd_HYBRIS_DISABLED
    oneshot
service uprobestats /apex/com.android.uprobestats/bin/uprobestats_HYBRIS_DISABLED
    oneshot
service mdnsd_netbpfload /apex/com.android.tethering/bin/netbpfload_HYBRIS_DISABLED
    oneshot
