# Device node permissions for /dev/fm, /dev/wmtWifi, /dev/goodix_fp,
# /dev/teei_fp and /dev/irtx come from the vendor ueventd.rc, which
# droid-hal converts to udev rules.

# Flashlight sysfs node permissions
ACTION=="add", SUBSYSTEM=="flashlight_core", RUN+="/bin/chmod 0666 /sys/class/flashlight_core/flashlight/flashlight_strobe /sys/class/flashlight_core/flashlight/flashlight_current"
